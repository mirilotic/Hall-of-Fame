<Window x:Class="Hall_Of_Fame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hall_Of_Fame"
        mc:Ignorable="d"
        Title="MainWindow" SizeToContent="WidthAndHeight">
    <Grid>
        <Image x:Name="IntroBild" HorizontalAlignment="Left" Height="184" Margin="201,28,0,0" VerticalAlignment="Top" Width="376" RenderTransformOrigin="0.49,0.51" Source="/Screenshot 2026-09-01 142927.png" Stretch="Fill"/>
        <Label x:Name="label_willkommen" Content="Willkommen in der Hall of Fame!&#xA;Möchtest du neue Sieger eintragen oder die bestehende&#xA;Tabelle ansehen?" FontSize="18" RenderTransformOrigin="0.496,0.454" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="158,225,158,117"/>
        <Button Margin="132,322,505,60" Content="Eintragen" FontSize="16" Click="EintragenButton_Click"></Button>
        <Button Margin="505,322,132,60" Content="Ansehen" FontSize="16" Click="AnsehenButton_Click"></Button>
    </Grid>
</Window>
